{
  "platform": "android",
  "name": "浮空棋境",
  "outputName": "android",
  "buildPath": "project://build",
  "debug": true,
  "packages": {
    "android": {
      "packageName": "com.shibaiderman.autochess",
      "apiLevel": 36,
      "appABIs": ["arm64-v8a"],
      "orientation": {
        "portrait": false,
        "upsideDown": false,
        "landscapeRight": true,
        "landscapeLeft": true
      },
      "useDebugKeystore": true,
      "appBundle": false,
      "androidInstant": false,
      "inputSDK": false,
      "isSoFileCompressed": true,
      "renderBackEnd": { "vulkan": false, "gles3": true, "gles2": true }
    }
  }
}
